---
/**
 * Setas decorativas (→ ↗ ↑) desenhadas em SVG: o subconjunto latin das fontes não tem
 * U+2192 nem U+2197, e o fallback do sistema quebraria o desenho. Sempre aria-hidden,
 * sempre ao lado de um texto que descreve o destino.
 */
interface Props {
  direcao?: 'direita' | 'diagonal' | 'cima';
  class?: string;
}

const { direcao = 'direita', class: classe } = Astro.props;
const tracos = {
  direita: 'M2.5 8h10.5M9 4l4 4-4 4',
  diagonal: 'M4 12l8-8M5.5 4H12v6.5',
  cima: 'M8 13.5V3M4 7l4-4 4 4',
}[direcao];
---

<svg
  class:list={['seta', classe]}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"><path d={tracos}></path></svg
>
