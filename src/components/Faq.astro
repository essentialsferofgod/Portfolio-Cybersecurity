---
/** 05 FAQ: <details>/<summary> nativos, com prefixo `?` em mono. */
import type { SecaoNumerada } from '../content/comandos.ts';
import type { Organizacao } from '../content/schema.ts';
import Secao from './Secao.astro';
import Texto from './Texto.astro';

interface Props {
  secao: SecaoNumerada;
  dados: Organizacao;
}

const { secao, dados } = Astro.props;
---

<Secao secao={secao}>
  <div class="perguntas">
    {
      dados.faq.map((item, i) => (
        <details id={`faq-${i + 1}`} class="pergunta">
          <summary>
            <span class="prefixo" aria-hidden="true">
              ?
            </span>
            <span class="min-w-0 flex-1">
              <Texto valor={item.pergunta} />
            </span>
            <span class="indicador" aria-hidden="true" />
          </summary>
          <div class="resposta">
            <p>
              <Texto valor={item.resposta} />
            </p>
          </div>
        </details>
      ))
    }
  </div>
</Secao>

<style>
  .perguntas {
    border-bottom: 1px solid var(--color-line);
  }

  .pergunta {
    border-top: 1px solid var(--color-line);
  }

  summary {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 1.25rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .prefixo,
  .indicador {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .indicador::before {
    content: '+' / '';
  }

  .pergunta[open] .indicador::before {
    content: '−' / '';
  }

  summary:hover .indicador {
    color: var(--color-text);
  }

  .resposta {
    max-width: 66ch;
    padding: 0 0 1.5rem calc(1ch + 1rem);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .pergunta[open] .resposta {
    animation: aparecer 160ms var(--ease-saida);
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
</style>
