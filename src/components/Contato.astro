---
/** 06 Contato: CTA principal para o canal preferencial e os canais reais como pares. */
import type { SecaoNumerada } from '../content/comandos.ts';
import { CANAIS } from '../content/schema.ts';
import type { Conteudo } from '../lib/conteudo.ts';
import { ACAO_CANAL, canalPrincipal, linkCanal, ROTULO_CANAL } from '../lib/conteudo.ts';
import { ehPendente } from '../content/schema.ts';
import Seta from './Seta.astro';
import Secao from './Secao.astro';
import Texto from './Texto.astro';

interface Props {
  secao: SecaoNumerada;
  conteudo: Conteudo;
}

const { secao, conteudo } = Astro.props;
const { dados } = conteudo;
const canais = CANAIS.flatMap((canal) => linkCanal(canal, dados) ?? []);
const principal = canalPrincipal(dados);
const { endereco, contatoSeguranca } = dados.contato;
const chamada = dados.chamadaFinal;
---

<Secao secao={secao}>
  {
    chamada && (
      <div class="mb-10">
        <p class="destaque">
          <Texto valor={chamada.titulo} />
        </p>
        {chamada.texto.map((p) => (
          <p class="mt-4 max-w-[60ch] text-text-muted">
            <Texto valor={p} />
          </p>
        ))}
      </div>
    )
  }
  {
    principal?.href && (
      <a href={principal.href} class="botao botao-claro w-full sm:w-auto">
        Falar com a equipe
        <span class="sr-only">({ACAO_CANAL[principal.canal]})</span>
        <Seta direcao={principal.externo ? 'diagonal' : 'direita'} />
      </a>
    )
  }

  <dl class="pares canais mt-12">
    {
      canais.map((link) => (
        <div>
          <dt>{ROTULO_CANAL[link.canal]}</dt>
          <dd>
            {link.href ? (
              <a href={link.href} class="valor-canal">
                <Seta direcao={link.externo ? 'diagonal' : 'direita'} class="text-text-muted" />
                <span class="min-w-0">{link.exibicao}</span>
                <span class="sr-only">({ACAO_CANAL[link.canal]})</span>
              </a>
            ) : (
              <Texto valor={link.exibicao} />
            )}
          </dd>
        </div>
      ))
    }
    {
      endereco && (
        <div>
          <dt>endereço</dt>
          <dd class="valor-texto">
            <Texto valor={endereco} />
          </dd>
        </div>
      )
    }
    {
      contatoSeguranca && (
        <div>
          <dt>segurança</dt>
          <dd>
            {ehPendente(contatoSeguranca) ? (
              <Texto valor={contatoSeguranca} />
            ) : (
              <a href={`mailto:${contatoSeguranca}`} class="valor-canal">
                <Seta class="text-text-muted" />
                <span class="min-w-0">{contatoSeguranca}</span>
              </a>
            )}
            <p class="rotulo mt-1">para relatar vulnerabilidades</p>
          </dd>
        </div>
      )
    }
  </dl>

  {
    dados.formularioDemo && (
      <form class="formulario mt-12" novalidate data-formulario-demo data-estado="inicial" aria-labelledby="formulario-titulo">
        <p id="formulario-titulo" class="destaque">Vamos falar de segurança.</p>
        <p class="mt-3 max-w-[60ch] text-text-muted">
          Conte sobre o seu ambiente, suas preocupações e o que precisa proteger.
        </p>
        <p class="rotulo mt-3">formulário de demonstração: nada é enviado nem guardado.</p>
        <div class="campos mt-6">
          <div class="campo">
            <label for="f-nome">Nome</label>
            <input id="f-nome" name="nome" type="text" autocomplete="name" data-obrigatorio aria-describedby="f-nome-erro" />
            <p id="f-nome-erro" class="erro" />
          </div>
          <div class="campo">
            <label for="f-email">E-mail corporativo</label>
            <input id="f-email" name="email" type="email" autocomplete="email" data-obrigatorio aria-describedby="f-email-erro" />
            <p id="f-email-erro" class="erro" />
          </div>
          <div class="campo">
            <label for="f-empresa">Empresa <span class="opcional">(opcional)</span></label>
            <input id="f-empresa" name="empresa" type="text" autocomplete="organization" />
          </div>
          <div class="campo">
            <label for="f-area">Área de interesse <span class="opcional">(opcional)</span></label>
            <select id="f-area" name="area">
              <option value="">Selecione</option>
              {dados.servicos.map((s) => (
                <option>{s.titulo}</option>
              ))}
              <option>Outro assunto</option>
            </select>
          </div>
          <div class="campo campo-largo">
            <label for="f-mensagem">Mensagem</label>
            <textarea id="f-mensagem" name="mensagem" rows="5" data-obrigatorio aria-describedby="f-mensagem-erro" />
            <p id="f-mensagem-erro" class="erro" />
          </div>
        </div>
        <button type="submit" class="botao botao-claro mt-6 w-full sm:w-auto">
          Enviar mensagem <Seta />
        </button>
        <p class="status mt-4" role="status" />
        <p class="rotulo mt-4">Suas informações merecem o mesmo cuidado que a sua infraestrutura.</p>
      </form>
    )
  }
</Secao>

<script>
  import { iniciarFormulario } from '../lib/formulario.ts';

  const formulario = document.querySelector<HTMLFormElement>('[data-formulario-demo]');
  if (formulario) iniciarFormulario(formulario);
</script>

<style>
  .canais {
    --largura-chave: 11ch;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }

  .canais > div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  @media (width >= 40rem) {
    .canais > div {
      align-items: baseline;
    }
  }

  .valor-canal {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 1.5rem;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 1rem;
    text-decoration: underline;
    text-decoration-color: var(--color-text-muted);
    overflow-wrap: anywhere;
    transition: text-decoration-color 160ms var(--ease-saida);
  }

  .valor-canal:hover {
    text-decoration-color: var(--color-text);
  }

  .valor-canal :global(.seta) {
    align-self: center;
  }

  .valor-texto {
    max-width: 66ch;
  }

  /* Sem JavaScript o formulário de demonstração não aparece: o contato é pelo e-mail. */
  :global(html:not(.js)) .formulario {
    display: none;
  }

  .formulario {
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .campos {
    display: grid;
    gap: 1.25rem;
  }

  @media (width >= 40rem) {
    .campos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .campo-largo {
      grid-column: 1 / -1;
    }
  }

  .campo label {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-rotulo);
    color: var(--color-text-muted);
  }

  .opcional {
    color: var(--color-text-muted);
  }

  .campo input,
  .campo select,
  .campo textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-text-muted);
    background-color: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 1rem;
    caret-color: var(--color-accent);
  }

  .campo textarea {
    resize: vertical;
  }

  .campo [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .erro {
    min-height: 1.25rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-rotulo);
    color: var(--color-error);
  }

  .status {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-text);
  }

  .formulario[data-estado='sucesso'] .status {
    color: var(--color-accent);
  }

  .formulario[data-estado='erro'] .status {
    color: var(--color-error);
  }
</style>
