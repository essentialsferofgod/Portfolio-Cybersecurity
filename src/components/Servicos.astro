---
/**
 * 01 Serviços, como arquivos abertos no terminal (`servico_01.md`). Cada cartão entra
 * "linha a linha" ao rolar. Os detalhes ficam em <details> abaixo de 1024 px e abertos
 * acima; com 1 ou 2 serviços, tudo fica aberto. A versão aberta e a recolhida coexistem
 * no HTML, cada uma oculta (display: none) na largura que não lhe cabe.
 */
import type { SecaoNumerada } from '../content/comandos.ts';
import type { Conteudo } from '../lib/conteudo.ts';
import DetalhesServico from './DetalhesServico.astro';
import Secao from './Secao.astro';
import Texto from './Texto.astro';

interface Props {
  secao: SecaoNumerada;
  conteudo: Conteudo;
}

const { secao, conteudo } = Astro.props;
const { dados, renderizadas } = conteudo;
const recolher = dados.servicos.length > 2;
const indice = (i: number) => String(i + 1).padStart(2, '0');
---

<Secao secao={secao}>
  <p class="rotulo tabular">{`${dados.servicos.length} ${dados.servicos.length === 1 ? 'serviço' : 'serviços'}`}</p>
  <ol class="servicos mt-4" role="list">
    {
      dados.servicos.map((servico, i) => (
        <li class="servico" data-revelar data-atraso={(i % 2) * 140}>
          <p class="arquivo" aria-hidden="true">
            <span>servico_{indice(i)}.md</span>
            <span class="tabular">{indice(i)}</span>
          </p>
          <div class="corpo">
            <h3 class="text-h3">
              <Texto valor={servico.titulo} />
            </h3>
            <p class="mt-2 text-text-muted">
              <Texto valor={servico.problema} />
            </p>
            {recolher ? (
              <>
                <details class="detalhes mt-4 lg:hidden">
                  <summary>
                    <span>
                      detalhes<span class="sr-only"> de {servico.titulo}</span>
                    </span>
                    <span class="indicador" aria-hidden="true" />
                  </summary>
                  <div class="pt-4">
                    <DetalhesServico servico={servico} dados={dados} />
                  </div>
                </details>
                <div class="mt-6 hidden lg:block">
                  <DetalhesServico servico={servico} dados={dados} />
                </div>
              </>
            ) : (
              <div class="mt-6">
                <DetalhesServico servico={servico} dados={dados} />
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
  {
    renderizadas.has('contato') && (
      <a href="#contato" class="botao botao-contorno mt-10 w-full sm:w-auto">
        Falar com a equipe
      </a>
    )
  }
</Secao>

<style>
  .servicos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .servico {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    transition: border-color 160ms var(--ease-saida);
  }

  .servico:hover {
    border-color: var(--color-text-muted);
  }

  .arquivo {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-rotulo);
    color: var(--color-text-muted);
  }

  .servico:hover .arquivo span:first-child::before {
    content: '> ' / '';
    color: var(--color-accent);
  }

  .corpo {
    padding: 1.25rem 1rem 1.5rem;
  }

  /* Cartões estreitos: chave sempre acima do valor. */
  .corpo :global(.pares > div) {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.125rem;
  }

  .detalhes summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    border-top: 1px dashed var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
  }

  .detalhes summary::-webkit-details-marker {
    display: none;
  }

  .detalhes summary:hover {
    color: var(--color-text);
  }

  .indicador::before {
    content: '+' / '';
    font-family: var(--font-mono);
  }

  .detalhes[open] .indicador::before {
    content: '−' / '';
  }

  .detalhes[open] > div {
    animation: aparecer 160ms var(--ease-saida);
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
</style>
