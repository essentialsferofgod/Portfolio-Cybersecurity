---
/**
 * Linha de status (seção 10, só ≥ 1024 px): caminho da seção atual, `<nn>/<total> <seção>`
 * e uma barra ASCII de progresso de rolagem, atualizados por navegacao.ts.
 * Decorativa (aria-hidden): o menu já comunica a seção atual com aria-current.
 * Fica oculta sem JavaScript e enquanto nenhuma seção está ativa (hero).
 */
import type { SecaoNumerada } from '../content/comandos.ts';

interface Props {
  caminho: string;
  secoes: SecaoNumerada[];
}

const { caminho, secoes } = Astro.props;
const total = String(secoes.length).padStart(2, '0');
---

<div id="linha-status" class="linha-status" aria-hidden="true" data-total={total} hidden>
  <div class="moldura flex h-full items-center justify-between gap-6">
    <span class="truncate" data-status-caminho data-base={caminho}>{caminho}</span>
    <span class="flex items-center gap-6">
      <span class="tabular" data-status-secao>01/{total}</span>
      <span class="tabular" data-status-barra>[░░░░░░░░░░░░░░░░]   0%</span>
    </span>
  </div>
</div>

<style>
  .linha-status {
    display: none;
  }

  @media (width >= 64rem) {
    .linha-status:not([hidden]) {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 40;
      display: block;
      height: 2rem;
      border-top: 1px solid var(--color-line);
      background-color: var(--color-bg);
      font-family: var(--font-mono);
      font-size: var(--text-rotulo);
      color: var(--color-text-muted);
      white-space: pre;
    }
  }

  [data-status-barra] {
    color: var(--color-accent);
  }
</style>
