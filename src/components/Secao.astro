---
/**
 * Moldura comum das seções numeradas: rótulo `01 / SERVIÇOS` com filete que se desenha ao
 * entrar na tela, prompt `$ cat servicos.md` digitado, título nas colunas 1–4 e conteúdo
 * nas colunas 5–12. As animações são decorativas e somem com movimento reduzido.
 */
import type { SecaoNumerada } from '../content/comandos.ts';
import Seta from './Seta.astro';

interface Props {
  secao: SecaoNumerada;
}

const { secao } = Astro.props;
const idTitulo = `${secao.id}-titulo`;
const comando = `cat ${secao.id}.md`;
---

<section id={secao.id} aria-labelledby={idTitulo} class="mt-(--espaco-secao)">
  <div class="grade">
    <div class="cabecalho-secao col-span-full flex items-center gap-4" data-revelar>
      <p class="rotulo tabular uppercase" aria-hidden="true">{secao.numero} / {secao.rotulo}</p>
      <span class="filete h-px flex-1 bg-line" aria-hidden="true"></span>
      <a href="#terminal" class="link-discreto">
        <Seta direcao="cima" /><span class="sr-only">voltar ao</span> terminal
      </a>
    </div>
    <p class="prompt-secao col-span-full mt-4" aria-hidden="true">
      <span class="cifrao">$</span> <span data-digitar={comando}>{comando}</span>
    </p>
    <h2 id={idTitulo} class="text-h2 col-span-full mt-4 lg:col-span-4 lg:mt-8 lg:pr-6" data-revelar>{secao.titulo}</h2>
    <div class="col-span-full mt-10 lg:col-span-8 lg:col-start-5 lg:mt-8" data-revelar data-atraso="120">
      <slot />
    </div>
  </div>
</section>

<style>
  /* O filete "se desenha" da esquerda para a direita, em passos. */
  .filete {
    transform-origin: left;
    transition: transform 700ms steps(14, end) 150ms;
  }
</style>
