---
import type { Conteudo } from '../lib/conteudo.ts';
import { slug } from '../lib/conteudo.ts';
import Seta from './Seta.astro';
import Terminal from './Terminal.astro';
import Texto from './Texto.astro';

interface Props {
  conteudo: Conteudo;
}

const { dados, renderizadas } = Astro.props.conteudo;
---

<section class="pt-[calc(var(--altura-cabecalho)+1.5rem)]" aria-labelledby="titulo-principal">
  <div class="grade gap-y-0">
    <p id="topo" class="rotulo col-span-full flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-line pb-3">
      <span>~/{slug(dados.nome) || 'organizacao'}</span>
      {
        dados.atuacao && (
          <span>
            <Texto valor={dados.atuacao} />
          </span>
        )
      }
    </p>

    <h1 id="titulo-principal" class="text-h1 col-span-full mt-12 lg:col-span-7 lg:mt-16">
      <Texto valor={dados.propostaDeValor} />
    </h1>

    <div class="col-span-full mt-8 sm:col-span-5 lg:col-span-6">
      {
        dados.subtitulo && (
          <p class="subtitulo">
            <Texto valor={dados.subtitulo} />
          </p>
        )
      }
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {
          renderizadas.has('contato') && (
            <a href="#contato" class="botao botao-primario">
              Falar com a equipe <Seta />
            </a>
          )
        }
        {
          renderizadas.has('servicos') && (
            <a href="#servicos" class="botao botao-secundario">
              Ver serviços
            </a>
          )
        }
      </div>
    </div>

    <div class="col-span-full mt-12 lg:col-span-5 lg:col-start-8 lg:row-start-3 lg:mt-8 lg:self-start">
      <Terminal conteudo={Astro.props.conteudo} />
    </div>
  </div>
</section>

<style>
  h1 {
    overflow-wrap: anywhere;
    hyphens: manual;
  }

  .subtitulo {
    max-width: 56ch;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  @media (width < 40rem) {
    .subtitulo {
      font-size: var(--text-corpo);
      line-height: var(--text-corpo--line-height);
    }
  }
</style>
