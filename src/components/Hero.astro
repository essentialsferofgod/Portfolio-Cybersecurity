---
import { ehPendente } from '../content/schema.ts';
import type { Conteudo } from '../lib/conteudo.ts';
import { slug } from '../lib/conteudo.ts';
import Seta from './Seta.astro';
import Terminal from './Terminal.astro';
import Texto from './Texto.astro';

interface Props {
  conteudo: Conteudo;
}

const { dados, renderizadas } = Astro.props.conteudo;
// Palavras separadas para a entrada "digitada" do h1 (CSS puro, sem mudar o texto).
const palavras = ehPendente(dados.propostaDeValor) ? null : dados.propostaDeValor.split(/\s+/);
---

<section class="hero relative overflow-hidden pt-[calc(var(--altura-cabecalho)+1.5rem)]" aria-labelledby="titulo-principal" data-hero>
  <canvas class="hero-fundo" aria-hidden="true"></canvas>
  <div class="grade relative gap-y-0">
    <p id="topo" class="rotulo col-span-full flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-line pb-3">
      <span>~/{slug(dados.nome) || 'organizacao'}<span class="cursor ml-1" aria-hidden="true"></span></span>
      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          dados.aviso && (
            <span class="selo">
              <span class="selo-ponto" aria-hidden="true" />
              demonstração
            </span>
          )
        }
        {
          dados.atuacao && (
            <span>
              <Texto valor={dados.atuacao} />
            </span>
          )
        }
      </span>
    </p>

    {
      dados.chamada && (
        <p class="rotulo col-span-full mt-12 uppercase lg:mt-16">
          <span class="text-accent" aria-hidden="true">// </span>
          <Texto valor={dados.chamada} />
        </p>
      )
    }
    <h1 id="titulo-principal" class:list={['text-h1 col-span-full lg:col-span-7', dados.chamada ? 'mt-4' : 'mt-12 lg:mt-16']}>
      {
        palavras ? (
          <>
            {palavras.map((palavra) => (
              <>
                <span class="palavra">{palavra}</span>{' '}
              </>
            ))}
            <span class="cursor cursor-h1" aria-hidden="true" />
          </>
        ) : (
          <Texto valor={dados.propostaDeValor} />
        )
      }
    </h1>

    <div class="entra entra-1 col-span-full mt-8 sm:col-span-5 lg:col-span-6">
      {
        dados.subtitulo && (
          <p class="subtitulo">
            <Texto valor={dados.subtitulo} />
          </p>
        )
      }
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {
          renderizadas.has('contato') && (
            <a href="#contato" class="botao botao-primario">
              Falar com a equipe <Seta />
            </a>
          )
        }
        {
          renderizadas.has('servicos') && (
            <a href="#servicos" class="botao botao-secundario">
              Ver serviços
            </a>
          )
        }
      </div>
      {
        dados.pilares.length > 0 && (
          <p class="rotulo mt-8 uppercase">
            {dados.pilares.map((p, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> / </span>}
                <Texto valor={p} />
              </>
            ))}
          </p>
        )
      }
    </div>

    <div class:list={['entra entra-2 col-span-full mt-12 lg:col-span-5 lg:col-start-8 lg:mt-8 lg:self-start', dados.chamada ? 'lg:row-start-3 lg:row-span-2' : 'lg:row-start-2 lg:row-span-2']}>
      <Terminal conteudo={Astro.props.conteudo} />
    </div>
  </div>
</section>

<script>
  import { iniciarFundo } from '../lib/fundo.ts';
  import { iniciarShader } from '../lib/shader.ts';

  const area = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = area?.querySelector('canvas');
  if (area && canvas && !iniciarShader(canvas, area)) iniciarFundo(canvas, area);
</script>

<style>
  h1 {
    overflow-wrap: anywhere;
    hyphens: manual;
  }

  .hero-fundo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    image-rendering: pixelated;
    /* Some antes do conteúdo de baixo e fica discreto atrás do texto. */
    mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 95%);
    opacity: 0.9;
  }

  .subtitulo {
    max-width: 56ch;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .selo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-text-muted);
    color: var(--color-text);
  }

  .selo-ponto {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent);
    animation: piscar 1.06s steps(1) infinite;
  }

  @media (width < 40rem) {
    .subtitulo {
      font-size: var(--text-corpo);
      line-height: var(--text-corpo--line-height);
    }
  }
</style>
